<Window x:Class="Mensajeria.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mensajería Académica | Chat" Height="760" Width="1120"
        MinHeight="600" MinWidth="880" WindowStartupLocation="CenterScreen"
        Background="#F3F6F7">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="250" MaxWidth="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#DCE3E8" BorderThickness="1,1,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                    <TextBlock Text="Mensajería" FontSize="20" FontWeight="SemiBold" Foreground="#173B46"/>
                    <TextBlock x:Name="txtSesion" Foreground="#61717F" Margin="0,3,0,12"/>
                    <ui:TextBox x:Name="txtBuscar" PlaceholderText="Buscar nombre o código"
                                TextChanged="TxtBuscar_TextChanged" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbFiltro" Margin="0,0,0,8" SelectionChanged="CmbFiltro_SelectionChanged">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Conectados"/>
                    </ComboBox>
                    <DockPanel>
                        <TextBlock Text="Contactos" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ui:Button DockPanel.Dock="Right" Content="Actualizar" Click="BtnActualizar_Click"/>
                    </DockPanel>
                </StackPanel>
                <Border x:Name="bannerOffline" Background="#FFFBEB" BorderBrush="#F2CE84" BorderThickness="1"
                        CornerRadius="8" Padding="9" Margin="8,0,8,8" Visibility="Collapsed">
                    <TextBlock Text="⛔ Sin conexión — mensajes en cola local, se reintentan solos"
                               Foreground="#B45309" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                </Border>
                <ListView x:Name="lstUsuarios" Margin="8,0,8,10" BorderThickness="0"
                          SelectionChanged="LstUsuarios_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding ColorPresencia}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Presencia}" FontSize="11" Foreground="#687A80"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="0,0,0,0" Background="#F7F9FA">
            <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DCE3E8" BorderThickness="1,1,1,0" Padding="18,12">
                <DockPanel>
                    <StackPanel>
                        <TextBlock x:Name="txtTitulo" FontSize="17" FontWeight="SemiBold" Foreground="#173B46" Text="Seleccione una conversación"/>
                        <TextBlock x:Name="txtEstado" Foreground="#61717F" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ui:Button Content="Difundir" Click="BtnDifundir_Click" Margin="0,0,6,0"/>
                        <ui:Button Content="Salir en todos" Click="BtnSalirTodos_Click" Margin="0,0,6,0"/>
                        <ui:Button Content="Salir" Click="BtnSalir_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Background="White" Margin="0"
                        AllowDrop="True" Drop="ZonaEnvio_Drop" DragOver="ZonaEnvio_DragOver">
                <TextBlock x:Name="txtRespuesta" Visibility="Collapsed" Foreground="#147D73"
                           TextTrimming="CharacterEllipsis" Margin="16,10,16,0"/>
                <TextBlock x:Name="txtImagenAdjunta" Foreground="#61717F" Margin="16,8,16,0" Text=""/>
                <StackPanel x:Name="panelArchivo" Orientation="Horizontal" Margin="16,6,16,0" Visibility="Collapsed">
                    <TextBlock x:Name="txtArchivoAdjunto" Foreground="#61717F" VerticalAlignment="Center" Text=""/>
                    <ui:Button x:Name="btnQuitarArchivo" Content="Quitar" Click="BtnQuitarArchivo_Click"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="panelPreview" Orientation="Horizontal" Margin="16,6,16,0" Visibility="Collapsed">
                    <Border BorderBrush="#DCE3E8" BorderThickness="1" Padding="4">
                        <Image x:Name="imgPreview" MaxHeight="90" MaxWidth="140" Stretch="Uniform"/>
                    </Border>
                    <ui:Button x:Name="btnQuitarImagen" Content="Quitar" Click="BtnQuitarImagen_Click"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Grid Margin="14,10,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="txtMensaje" Grid.Column="0" MinHeight="42" TextWrapping="Wrap"
                                TextChanged="TxtMensaje_TextChanged" KeyDown="TxtMensaje_KeyDown"
                                PlaceholderText="Escribe un mensaje (Enter para enviar)" Margin="0,0,8,0"/>
                    <ui:Button x:Name="btnAdjuntar" Grid.Column="1" Content="Imagen" Click="BtnAdjuntar_Click" Margin="0,0,6,0" ToolTipService.ToolTip="Adjuntar imagen"/>
                    <ui:Button x:Name="btnAdjuntarArchivo" Grid.Column="2" Content="Archivo" Click="BtnAdjuntarArchivo_Click" Margin="0,0,6,0" ToolTipService.ToolTip="Adjuntar archivo (hasta 50 MB)"/>
                    <ui:Button x:Name="btnEnviar" Grid.Column="3" Content="Enviar" Appearance="Primary" Click="BtnEnviar_Click" MinWidth="82"/>
                </Grid>
            </StackPanel>
            <ui:Button x:Name="btnAnteriores" DockPanel.Dock="Top" Content="Cargar mensajes anteriores"
                        Click="BtnAnteriores_Click" HorizontalAlignment="Center" Margin="8" Visibility="Collapsed"/>
            <ListBox x:Name="lstMensajes" Background="#F7F9FA" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     AllowDrop="True" Drop="ZonaEnvio_Drop" DragOver="ZonaEnvio_DragOver"
                     ToolTipService.ToolTip="Arrastra aquí imágenes o archivos para adjuntar">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Fondo}" BorderBrush="#E2E8EA" BorderThickness="1" Padding="12" Margin="6,5" MaxWidth="720" HorizontalAlignment="{Binding Alineacion}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding Encabezado}" FontWeight="SemiBold" Foreground="#17635B"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Estado}" Foreground="{Binding ColorEstado}" FontSize="11" Margin="16,0,0,0"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Contenido}" TextWrapping="Wrap" Margin="0,7,0,0"
                                           Visibility="{Binding MostrarTexto}"/>
                                <Image Source="{Binding Imagen}" MaxHeight="260" MaxWidth="420" Stretch="Uniform"
                                       HorizontalAlignment="Left" Margin="0,8,0,0"
                                       Visibility="{Binding MostrarImagen}" Loaded="MessageImage_Loaded"/>
                                <TextBlock Text="{Binding EstadoImagen}" Foreground="#61717F" FontSize="11" Margin="0,4,0,0"
                                           Visibility="{Binding MostrarImagen}"/>
                                <Button Content="Reintentar imagen" HorizontalAlignment="Left" Margin="0,3,0,0"
                                         Visibility="{Binding MostrarReintento}" Click="BtnReintentarImagen_Click"/>
                                <Button Content="Descargar archivo" HorizontalAlignment="Left" Margin="0,3,0,0"
                                         Visibility="{Binding MostrarDescarga}" Click="BtnDescargarArchivo_Click"/>
                                <DockPanel LastChildFill="False" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Fecha}" Foreground="#687A80" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <Button Content="Responder" DockPanel.Dock="Right" Margin="8,0,0,0"
                                         Padding="4,1" Click="BtnResponder_Click"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
