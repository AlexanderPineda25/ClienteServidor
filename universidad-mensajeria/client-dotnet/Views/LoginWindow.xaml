<Window x:Class="Mensajeria.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mensajería Académica | Iniciar sesión" MinHeight="390" MinWidth="390"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="32" VerticalAlignment="Center" MinWidth="320">
        <TextBlock Text="UNIVERSIDAD" Foreground="#147D73" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="Mensajería Académica" FontSize="23" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Text="Ingresa con tus credenciales institucionales." Foreground="#61717F" TextWrapping="Wrap" Margin="0,0,0,24"/>
        <TextBlock Text="Código" Margin="0,0,0,5"/>
        <ui:TextBox x:Name="txtCodigo" PlaceholderText="Código institucional" ClearButtonEnabled="True" Margin="0,0,0,14"/>
        
        <TextBlock Text="Contraseña" Margin="0,0,0,5"/>
        <ui:PasswordBox x:Name="txtContrasena" PlaceholderText="Contraseña" Margin="0,0,0,20"/>
        
        <ui:Button Content="Entrar" Appearance="Primary" Click="BtnEntrar_Click" MinHeight="38"/>
        <!-- Fase 10.2 (P2): sin «Crear cuenta»: el alta es solo por archivo plano (CSV). -->

        <TextBlock x:Name="txtError" Foreground="Red" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
